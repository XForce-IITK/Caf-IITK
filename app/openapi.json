  "info": {
    "title": "Caf@IITK API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/admin/inventory/{service_date}/{item_id}": {
      "put": {
        "description": "FR-14 / US-11: set the prepared portions of an item for a service date (0-500).",
        "operationId": "set_inventory",
        "parameters": [
          {
            "in": "path",
            "name": "service_date",
            "required": true,
            "schema": {
              "format": "date",
              "title": "Service Date",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "item_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Item Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InventorySet"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InventoryOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "description": "Only the Administrator manages inventory"
          },
          "404": {
            "description": "No such menu item"
          },
          "409": {
            "description": "Item is not ACTIVE, the service date is not configured, or the total is below the portions already allocated"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Set Inventory",
        "tags": [
          "inventory"
        ]
      }
    },
    "/api/v1/admin/items": {
      "post": {
        "description": "FR-8 / US-06: add a dish; it is ACTIVE immediately.",
        "operationId": "onboard_item",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ItemCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "description": "Only the Administrator onboards items"
          },
          "422": {
            "description": "Invalid input, or an ACTIVE item already has this name"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Onboard Item",
        "tags": [
          "catalogue"
        ]
      }
    },
    "/api/v1/admin/service-days/{service_date}": {
      "put": {
        "description": "FR-17 / US-14: configure a service date's window and generate its slots.",
        "operationId": "configure_service_day",
        "parameters": [
          {
            "in": "path",
            "name": "service_date",
            "required": true,
            "schema": {
              "format": "date",
              "title": "Service Date",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ServiceDayConfig"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceDayOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "description": "Only the Administrator configures service windows"
          },
          "409": {
            "description": "Orders already reference this day's slots"
          },
          "422": {
