# Copy to .env next to docker-compose.prod.yml on the EC2 instance, fill in, and
# `chmod 600 .env`. Never commit the filled-in file (NFR-24); .env is git-ignored.

# The public hostname: nginx's certificate, the client origin and the CORS list.
CAF_HOST=replace-with-hostname

# RDS. Use a password of letters and digits only, so it needs no URL-encoding.
CAF_DATABASE_URL=postgresql+psycopg://caf:replace-with-rds-password@replace-with-rds-endpoint:5432/caf?sslmode=require

# At least 32 bytes: `openssl rand -base64 48`
CAF_JWT_SECRET=replace-with-a-long-random-string

# caf-api processes, and database connections per process. A db.t4g.micro allows
# about 80 connections; 2 x 5 for caf-api plus caf-worker's stays well under that.
WEB_CONCURRENCY=2
CAF_DB_POOL_SIZE=5

# Seeded on the first start (FR-2). Existing emails are left unchanged.
CAF_SEED_ADMIN_EMAIL=admin@iitk.ac.in
CAF_SEED_ADMIN_PASSWORD=replace-with-a-strong-password
CAF_SEED_KITCHEN_EMAIL=kitchen@iitk.ac.in
CAF_SEED_KITCHEN_PASSWORD=replace-with-a-strong-password

# Kitchen Planning Agent LLM. Leave the key empty to use only the heuristic planner.
CAF_LLM_API_KEY=
CAF_LLM_MODEL=gpt-4o-mini
