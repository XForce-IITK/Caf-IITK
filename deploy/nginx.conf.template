# nginx for the AWS stack (docker-compose.prod.yml). The nginx image substitutes
# ${CAF_HOST} at start-up; nginx's own $variables are left alone.

# NFR-27: HTTPS only.
server {
    listen 80;
    server_name ${CAF_HOST};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${CAF_HOST};

    ssl_certificate /etc/letsencrypt/live/${CAF_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CAF_HOST}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;

    # The client and the API share this origin, so CORS allows only it.
    location /api/ {
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
        # Replace, never append: a client must not choose the address that the
        # login rate limit counts (NFR-21).
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    location = /health {
        proxy_pass http://api:8000;
    }

    location = /ready {
        proxy_pass http://api:8000;
    }

    # Metrics stay off the internet; read them on the instance at 127.0.0.1:8000.
    location = /metrics {
        return 404;
    }

    # The Flutter web build; unknown paths are client routes.
    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }
}
