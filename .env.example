# Copy to .env and fill in real values. .env is git-ignored (NFR-24).
POSTGRES_USER=caf
POSTGRES_PASSWORD=caf
POSTGRES_DB=caf

CAF_ENV=development
CAF_JWT_SECRET=replace-with-a-long-random-string

# Browser origins allowed to call the API, as a JSON list (NFR-27). Any
# localhost port is also allowed unless CAF_ENV=production.
CAF_CORS_ORIGINS=[]

# Seeded on `docker compose up` if set (FR-2). Existing emails are left unchanged.
CAF_SEED_ADMIN_EMAIL=admin@iitk.ac.in
CAF_SEED_ADMIN_PASSWORD=replace-with-a-strong-password
CAF_SEED_KITCHEN_EMAIL=kitchen@iitk.ac.in
CAF_SEED_KITCHEN_PASSWORD=replace-with-a-strong-password

# Kitchen Planning Agent LLM (OpenAI). Leave the key unset to use only the
# heuristic planner. Never commit a real key (NFR-24).
CAF_LLM_API_KEY=
CAF_LLM_MODEL=gpt-4o-mini
